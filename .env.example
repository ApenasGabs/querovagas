# ==========================================================
# QueroVagas - Configuração de Variáveis de Ambiente
# ==========================================================

# Provedor de dados: "mock" (dados simulados ricos) ou "supabase"
# Se as chaves do Supabase não forem preenchidas, o sistema usa "mock" automaticamente.
VITE_DATA_PROVIDER=supabase

# Credenciais Públicas do Supabase (Project Settings -> API -> Project URL & anon/public key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Link de Convite para o Canal de Transmissão no WhatsApp (Opcional - Broadcast aberto)
# Exemplo: https://whatsapp.com/channel/0029Va...
VITE_WHATSAPP_CHANNEL_URL=
